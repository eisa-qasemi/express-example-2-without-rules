    </div>
</section>

<section class="office-section">
    <div class="container">
        <div class="office-content">
            <div class="office-text">
                <h2>Our Modern Office</h2>
                <p>Located in the heart of the tech district, our office provides the perfect environment for creativity and innovation. We believe that great software is built by great teams in great spaces.</p>
                <a href="/contact" class="btn btn-primary">
                    <i class="fas fa-map-marker-alt"></i>
                    Visit Us
                </a>
            </div>
            <div class="office-image-container">
                <div class="image-placeholder office-image">
                    <i class="fas fa-building" style="font-size: 4rem; color: #007bff;"></i>
                    <div style="margin-top: 1rem; font-size: 1.2rem;">Modern Office Space</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2>Ready to Get Started?</h2>
            <p>Join thousands of developers building amazing applications with Express.js</p>
            <a href="/contact" class="btn btn-primary btn-large">
                <i class="fas fa-rocket"></i>
                Start Building
            </a>
        </div>
    </div>
</section> 