<div class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">
            <span class="gradient-text">Welcome to Our</span><br>
            Express.js Application
        </h1>
        <p class="hero-subtitle"><%= message %></p>
        <div class="hero-buttons">
            <a href="/about" class="btn btn-primary">
                <i class="fas fa-info-circle"></i>
                Learn More
            </a>
            <a href="/contact" class="btn btn-secondary">
                <i class="fas fa-envelope"></i>
                Get in Touch
            </a>
        </div>
    </div>
    <div class="hero-image">
        <div class="hero-image-container">
            <div class="image-placeholder" style="width: 400px; height: 300px;">
                <i class="fas fa-code" style="font-size: 4rem; color: #007bff;"></i>
                <div style="margin-top: 1rem; font-size: 1.2rem;">Express.js</div>
            </div>
        </div>
    </div>
</div>

<section class="features-section">
    <div class="container">
        <h2 class="section-title">Why Choose Express.js?</h2>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <h3>Fast & Lightweight</h3>
                <p>Minimal and flexible Node.js web application framework that provides a robust set of features.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h3>Secure</h3>
                <p>Built with security in mind, providing protection against common web vulnerabilities.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-puzzle-piece"></i>
                </div>
                <h3>Extensible</h3>
                <p>Rich ecosystem of middleware and plugins to extend functionality as needed.</p>
            </div>
        </div>
    </div>
</section>

