</div>

<section class="about-section">
    <div class="container">
        <div class="about-content">
            <div class="about-text">
                <h2>Our Story</h2>
                <p><%= content %></p>
                <p>Express.js is a minimal and flexible Node.js web application framework that provides a robust set of features for web and mobile applications. With a myriad of HTTP utility methods and middleware at your disposal, creating a robust API is quick and easy.</p>
                
                <div class="office-image-container" style="margin-top: 2rem;">
                    <div class="image-placeholder office-image">
                        <i class="fas fa-users" style="font-size: 4rem; color: #007bff;"></i>
                        <div style="margin-top: 1rem; font-size: 1.2rem;">Our Team at Work</div>
                    </div>
                </div>
            </div>
            <div class="about-stats">
                <div class="stat-item">
                    <div class="stat-number">50M+</div>
                    <div class="stat-label">Downloads</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">100K+</div>
                    <div class="stat-label">GitHub Stars</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">10K+</div>
                    <div class="stat-label">Contributors</div>
                </div>
            </div>
        </div>
    </div>
</section>

